# Environment Variables Template for IPOCircle / IPO Pulse
DATABASE_URL=sqlite:///ipocircle.db
# Production PostgreSQL example: postgresql://ipouser:ipopassword@localhost:5432/ipodb

REDIS_URL=redis://localhost:6379/0
SECRET_KEY=ipocircle-secret-key-prod-2026-key
JWT_SECRET_KEY=ipocircle-jwt-secret-key-2026

# OAuth & Email Alerts (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
EMAIL_API_KEY=your-sendgrid-or-ses-key
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Admin Defaults
ADMIN_EMAIL=admin@ipocircle.in
ADMIN_PASSWORD=Admin@12345

# Data Ingestion Timezone & Sync Interval
TIMEZONE=Asia/Kolkata
SYNC_INTERVAL_SECONDS=21600
